# EN: THE GUERRA GRANDE, 22/9/2026 (second pass, after Juan read it on screen): the two sides face to
#     face above the balance; everything else below it, short, with the rules in a fold-out. The
#     engine's own status box, long text, countries and conditions are hidden (CMF com_hide_*),
#     the way Gates of the Bosphorus does it.
# ES: LA GUERRA GRANDE, segunda pasada: los dos bandos arriba de la balanza; lo demas debajo, corto,
#     con las reglas en un desplegable. Lo que el motor dibuja solo se esconde (com_hide_* del CMF).
flowcontainer = {
	name = "gg_war_overview"
	direction = vertical
	parentanchor = hcenter
	spacing = 8
	ignoreinvisible = yes
	dynamicgridbox = {
		visible = "[Not(GetGlobalVariable('guerra_grande_split_done').IsSet)]"
		datamodel = "[JournalEntry.GetInvolvedCountries]"
		datamodel_wrap = 1
		ignoreinvisible = yes
		item = {
			flowcontainer = {
				direction = horizontal
				spacing = 16
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_colorado')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 252 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 8 12 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 100 10 } size = { 144 92 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_leader_colorado"
							}
						}
					}
				}
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_blanco')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 252 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 8 12 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 100 10 } size = { 144 92 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_leader_blanco"
							}
						}
					}
				}
			}
		}
	}
	flowcontainer = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		direction = horizontal
		spacing = 16
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_defensa_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					size = { 252 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = {
						position = { 8 12 }
						datacontext = "[Country.GetRuler]"
					}
					textbox = {
						position = { 100 10 } size = { 144 92 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_leader_defensa"
					}
				}
			}
		}
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_cerrito_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					size = { 252 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = {
						position = { 8 12 }
						datacontext = "[Country.GetRuler]"
					}
					textbox = {
						position = { 100 10 } size = { 144 92 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_leader_cerrito"
					}
				}
			}
		}
	}
}

# EN/ES: below the balance / debajo de la balanza
flowcontainer = {
	name = "gg_war_details"
	direction = vertical
	parentanchor = hcenter
	spacing = 6
	ignoreinvisible = yes
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)0')]"
		tooltip = "gg_war_ui_phase_0_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_0"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)1')]"
		tooltip = "gg_war_ui_phase_1_tt"
