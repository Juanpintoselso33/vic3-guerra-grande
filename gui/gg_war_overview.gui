# EN: Original two-sided war brief. Values are read from the existing arbiter.
# ES: Parte de dos bandos propio. Los valores vienen del arbitro existente.
flowcontainer = {
	name = "gg_war_overview"
	direction = vertical
	parentanchor = hcenter
	spacing = 8
	ignoreinvisible = yes
	dynamicgridbox = {
		visible = "[Not(GetGlobalVariable('guerra_grande_split_done').IsSet)]"
		datamodel = "[JournalEntry.GetInvolvedCountries]"
		datamodel_wrap = 1
		ignoreinvisible = yes
		item = {
			flowcontainer = {
				direction = horizontal
				spacing = 16
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_colorado')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 252 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 8 12 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 100 10 } size = { 144 92 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_cause_leader"
							}
						}
					}
				}
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_blanco')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 252 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 8 12 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 100 10 } size = { 144 92 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_cause_leader"
							}
						}
					}
				}
			}
		}
	}
	flowcontainer = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		direction = horizontal
		spacing = 16
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_defensa_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					size = { 252 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = {
						position = { 8 12 }
						datacontext = "[Country.GetRuler]"
					}
					textbox = {
						position = { 100 10 } size = { 144 92 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_current_ruler"
					}
				}
			}
		}
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_cerrito_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					size = { 252 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = {
						position = { 8 12 }
						datacontext = "[Country.GetRuler]"
					}
					textbox = {
						position = { 100 10 } size = { 144 92 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_current_ruler"
					}
				}
			}
		}
	}
	# EN: 22/9/2026 -- Tanzimat-style reading of the balance (the native bar above): what moved it last
	#     month, by source; each government's exhaustion; the phase and its effects; the peace table;
	#     and the Defensa's own pledges (moved here from the River Plate journal).
	# ES: lectura de la balanza al estilo Tanzimat: que la movio el mes pasado, por fuente; el agotamiento
	#     de cada gobierno; la fase y sus efectos; la mesa de paz; y los compromisos de la Defensa.
	textbox = {
		tooltip = "gg_war_ui_sources_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_sources"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_partition_moved'), '(CFixedPoint)1')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_sources_partition"
	}
	flowcontainer = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		direction = horizontal spacing = 16
		flowcontainer = {
			direction = vertical spacing = 2
			textbox = { size = { 252 26 } using = fontsize_medium text = "gg_war_ui_exhaustion_cerrito" }
			green_progressbar_horizontal = {
				size = { 252 22 }
				blockoverride "values" { value = "[JournalEntry.MakeScope.ScriptValue('gg_ui_exhaustion_cerrito_pct')]" min = 0 max = 100 }
			}
		}
		flowcontainer = {
			direction = vertical spacing = 2
			textbox = { size = { 252 26 } using = fontsize_medium text = "gg_war_ui_exhaustion_defensa" }
			green_progressbar_horizontal = {
				size = { 252 22 }
				blockoverride "values" { value = "[JournalEntry.MakeScope.ScriptValue('gg_ui_exhaustion_defensa_pct')]" min = 0 max = 100 }
			}
		}
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)0')]"
		tooltip = "gg_war_ui_phase_0_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_0"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)1')]"
		tooltip = "gg_war_ui_phase_1_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_1"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)2')]"
		tooltip = "gg_war_ui_phase_2_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_2"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)3')]"
		tooltip = "gg_war_ui_phase_3_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_3"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)4')]"
		tooltip = "gg_war_ui_phase_4_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_4"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)5')]"
		tooltip = "gg_war_ui_phase_5_tt"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_phase_5"
	}
	textbox = {
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_large align = left|nobaseline
		text = "gg_war_ui_diplomacy_title"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)0')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_0"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)1')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_1"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)2')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_2"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)3')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_3"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)4')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_4"
	}
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)5')]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_war_ui_diplomacy_5"
	}
	textbox = {
		visible = "[GetGlobalVariable('gg_imperial_pledged').IsSet]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_ui_brazil_commitment"
	}
	textbox = {
		visible = "[GetGlobalVariable('gg_customs_mortgaged').IsSet]"
		autoresize = yes multiline = yes
		minimumsize = { 520 -1 } maximumsize = { 520 -1 }
		using = fontsize_medium align = left|nobaseline
		text = "gg_ui_customs_commitment"
	}
}
