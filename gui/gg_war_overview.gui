				tooltip = "gg_tt_patron_francia_pre_1"
				size = { 124 62 }
				background = { using = dark_area alpha = 0.3 }
				multiline = yes
				using = fontsize_medium align = center|nobaseline
				text = "gg_war_ui_power_francia_1"
			}
			textbox = {
				visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_patron_level_francia'), '(CFixedPoint)2'), GetGlobalVariable('guerra_grande_split_done').IsSet)]"
				tooltip = "gg_tt_patron_francia_now_2"
				size = { 124 62 }
				background = { using = dark_area alpha = 0.3 }
				multiline = yes
				using = fontsize_medium align = center|nobaseline
				text = "gg_war_ui_power_francia_2"
			}
			textbox = {
				visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_patron_level_francia'), '(CFixedPoint)2'), Not(GetGlobalVariable('guerra_grande_split_done').IsSet))]"
				tooltip = "gg_tt_patron_francia_pre_2"
				size = { 124 62 }
				background = { using = dark_area alpha = 0.3 }
				multiline = yes
				using = fontsize_medium align = center|nobaseline
				text = "gg_war_ui_power_francia_2"
			}
			# EN/ES: 23/9 (Juan: "tengo que ver el puntaje de cada potencia y como se inclina") -- the number
			#     behind the level, 20 Protector / 60 Guarantor / el numero detras del nivel
			green_progressbar_horizontal = {
				size = { 100 6 }
				parentanchor = hcenter
				tooltip = "gg_tt_power_number"
				blockoverride "values" {
					value = "[GetGlobalVariable('gg_patron_francia').GetValue]"
					min = 0 max = 100
				}
			}
		}
