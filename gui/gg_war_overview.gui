# EN: THE GUERRA GRANDE, third pass (22/9/2026, the vic3-journals skill): Descalzo's Arroyo Grande
#     as the header with the phase on it; one short line; the two sides face to face with their
#     patrons' flags; "The balance" just above the bar; below it, only what is running (each
#     government's endurance, the peace table); the longer account behind the arrow. Every line is
#     backed by docs/guerra-grande-flujo/guerra-grande-textos-mecanica.md.
# ES: LA GUERRA GRANDE, tercera pasada: el Arroyo Grande de Descalzo como encabezado con la fase
#     encima; una linea corta; los dos bandos cara a cara con las banderas de sus padrinos; "La
#     balanza" justo arriba de la barra; debajo, solo lo que esta corriendo (el aguante de cada
#     gobierno, la mesa de paz); lo largo detras de la flechita. Cada linea la respalda la tabla de
#     mecanica del repo de diseno.
#     Painting: Carlos Descalzo, "Batalla de Arroyo Grande", 19th century (public domain, Commons).

# EN/ES: above the bar (custom_widget_container_je_icon) / arriba de la barra
flowcontainer = {
	name = "gg_war_overview"
	direction = vertical
	parentanchor = hcenter
	spacing = 16
	ignoreinvisible = yes
	widget = {
		size = { 520 252 }
		parentanchor = hcenter
		icon = {
			size = { 520 240 }
			position = { 0 6 }
			texture = "gfx/interface/gg_situations/war_header.dds"
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)1')]"
			tooltip = "gg_war_ui_phase_1_tt"
			position = { 0 206 } size = { 520 40 }
			background = { using = dark_area alpha = 0.8 }
			using = fontsize_large align = center|nobaseline
			text = "gg_war_ui_phase_1"
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)2')]"
			tooltip = "gg_war_ui_phase_2_tt"
			position = { 0 206 } size = { 520 40 }
			background = { using = dark_area alpha = 0.8 }
			using = fontsize_large align = center|nobaseline
			text = "gg_war_ui_phase_2"
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)3')]"
			tooltip = "gg_war_ui_phase_3_tt"
			position = { 0 206 } size = { 520 40 }
			background = { using = dark_area alpha = 0.8 }
			using = fontsize_large align = center|nobaseline
			text = "gg_war_ui_phase_3"
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)4')]"
			tooltip = "gg_war_ui_phase_4_tt"
			position = { 0 206 } size = { 520 40 }
			background = { using = dark_area alpha = 0.8 }
			using = fontsize_large align = center|nobaseline
			text = "gg_war_ui_phase_4"
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_war_phase'), '(CFixedPoint)5')]"
			tooltip = "gg_war_ui_phase_5_tt"
			position = { 0 206 } size = { 520 40 }
			background = { using = dark_area alpha = 0.8 }
			using = fontsize_large align = center|nobaseline
			text = "gg_war_ui_phase_5"
		}
	}
	# EN/ES: the short line, one before the split and one after / la linea corta, antes y despues de la particion
	textbox = {
		visible = "[Not(GetGlobalVariable('guerra_grande_split_done').IsSet)]"
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_war_ui_short_prewar"
	}
	textbox = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_war_ui_short_split"
	}
	textbox = {
		size = { 520 34 }
		parentanchor = hcenter
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_sides"
	}
	# EN/ES: before the split, Rivera and Oribe (colorados on the left, as on the bar)
	#     / antes de la particion, Rivera y Oribe (colorados a la izquierda, como en la barra)
	dynamicgridbox = {
		visible = "[Not(GetGlobalVariable('guerra_grande_split_done').IsSet)]"
		parentanchor = hcenter
		datamodel = "[JournalEntry.GetInvolvedCountries]"
		datamodel_wrap = 1
		ignoreinvisible = yes
		item = {
			flowcontainer = {
				direction = horizontal
				spacing = 8
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_colorado')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 236 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 6 10 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 96 8 } size = { 134 96 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_leader_colorado"
							}
						}
					}
				}
				textbox = { size = { 32 112 } align = center|vcenter using = fontsize_large text = "gg_war_ui_versus" }
				dynamicgridbox = {
					datamodel = "[Country.MakeScope.GetList('gg_ui_prewar_blanco')]"
					datamodel_wrap = 1
					item = {
						widget = {
							size = { 236 112 }
							background = { using = dark_area alpha = 0.3 }
							character_portrait_medium = { position = { 6 10 } datacontext = "[Scope.AccessCharacter]" }
							textbox = {
								position = { 96 8 } size = { 134 96 }
								datacontext = "[Scope.AccessCharacter]"
								multiline = yes using = fontsize_medium
								text = "gg_war_ui_leader_blanco"
							}
						}
					}
				}
			}
		}
	}
	# EN/ES: from the split, the two governments; the tooltip is who backs each one and what it buys
	#     / desde la particion, los dos gobiernos; el tooltip es quien sostiene a cada uno y que compra
	flowcontainer = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		direction = horizontal
		spacing = 8
		parentanchor = hcenter
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_defensa_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					tooltip = "gg_war_ui_card_defensa_tt"
					size = { 236 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
					textbox = {
						position = { 96 8 } size = { 134 96 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_leader_defensa"
					}
				}
			}
		}
		textbox = { size = { 32 112 } align = center|vcenter using = fontsize_large text = "gg_war_ui_versus" }
		dynamicgridbox = {
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			datamodel_wrap = 1
			ignoreinvisible = yes
			item = {
				widget = {
					visible = "[GetScriptedGui('gg_ui_cerrito_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
					tooltip = "gg_war_ui_card_cerrito_tt"
					size = { 236 112 }
					background = { using = dark_area alpha = 0.3 }
					character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
					textbox = {
						position = { 96 8 } size = { 134 96 }
						datacontext = "[Country.GetRuler]"
						multiline = yes using = fontsize_medium
						text = "gg_war_ui_leader_cerrito"
					}
				}
			}
		}
	}
	# EN/ES: 22/9/2026 -- the powers' levels (design B): each power's standing towards the Defensa, with
	#     what it buys in the tooltip; the level lives here because money and backing live in this
	#     journal's pulse / los niveles de las potencias: la posicion de cada una frente a la Defensa
	# EN/ES: playtest 22/9 -- the section shows from 1836: before the partition it reads what each power
	#     promises the government of Montevideo, after it what it gives the Defensa / la seccion se ve desde
	#     1836: antes de la particion, lo que cada potencia le promete al gobierno de Montevideo; despues, a la Defensa
	textbox = {
		visible = "[Not(GetGlobalVariable('guerra_grande_split_done').IsSet)]"
		tooltip = "gg_war_ui_sec_powers_pre_tt"
		size = { 520 34 }
		parentanchor = hcenter
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_powers"
	}
	textbox = {
		visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
		tooltip = "gg_war_ui_sec_powers_tt"
		size = { 520 34 }
		parentanchor = hcenter
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_powers"
	}
	# EN/ES: 23/9 (Juan: "filas") -- two rows by side: who backs the colorados (the powers, and Urquiza once he
	#     turns) and who backs the blancos (Rosas, Urquiza while he stays); Urquiza moves between them
	#     / dos filas por lado: quien sostiene a los colorados y quien a los blancos; Urquiza pasa de una a otra
	textbox = {
		size = { 520 26 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_war_ui_row_colorados"
	}
	flowcontainer = {
		direction = horizontal spacing = 8
		parentanchor = hcenter
		ignoreinvisible = yes
				flowcontainer = {
			direction = vertical ignoreinvisible = yes
			textbox = {
				visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_patron_level_francia'), '(CFixedPoint)0'), GetGlobalVariable('guerra_grande_split_done').IsSet)]"
				tooltip = "gg_tt_patron_francia_now_0"
				size = { 124 62 }
				background = { using = dark_area alpha = 0.3 }
				multiline = yes
				using = fontsize_medium align = center|nobaseline
				text = "gg_war_ui_power_francia_0"
			}
			textbox = {
				visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_patron_level_francia'), '(CFixedPoint)0'), Not(GetGlobalVariable('guerra_grande_split_done').IsSet))]"
				tooltip = "gg_tt_patron_francia_pre_0"
				size = { 124 62 }
				background = { using = dark_area alpha = 0.3 }
				multiline = yes
				using = fontsize_medium align = center|nobaseline
