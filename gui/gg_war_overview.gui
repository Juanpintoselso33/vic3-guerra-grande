# EN/ES: right above the bar (custom_widget_container_3): its title, with what moves it in the tooltip
#     / justo arriba de la barra: su titulo, con lo que la mueve en el tooltip
flowcontainer = {
	name = "gg_war_balance_head"
	direction = vertical
	parentanchor = hcenter
	textbox = {
		size = { 520 34 }
		parentanchor = hcenter
		tooltip = "gg_war_ui_sec_balance_tt"
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_balance"
	}
}

# EN/ES: below the bar (custom_widget_container_4): only what is running / debajo de la barra: solo lo que corre
flowcontainer = {
	name = "gg_war_details"
	direction = vertical
	parentanchor = hcenter
	spacing = 14
	ignoreinvisible = yes
	widget = { size = { 520 6 } }
	# EN/ES: each government's endurance, only while one of them is counting months
	#     / el aguante de cada gobierno, solo mientras alguno cuenta meses
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_endurance_shown'), '(CFixedPoint)1')]"
		size = { 520 34 }
		parentanchor = hcenter
		tooltip = "gg_war_ui_sec_endurance_tt"
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_endurance"
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_endurance_defensa_shown'), '(CFixedPoint)1')]"
		tooltip = "gg_war_ui_sec_endurance_tt"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 40 40 } texture = "gfx/interface/icons/military_icons/morale.dds" }
		flowcontainer = {
			direction = vertical spacing = 2
			textbox = { multiline = yes autoresize = yes minimumsize = { 472 -1 } maximumsize = { 472 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_endurance_defensa" }
			green_progressbar_horizontal = {
				size = { 472 22 }
				blockoverride "values" {
					value = "[JournalEntry.MakeScope.ScriptValue('gg_ui_exhaustion_defensa_pct')]"
					min = 0 max = 100
				}
			}
		}
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_endurance_cerrito_shown'), '(CFixedPoint)1')]"
		tooltip = "gg_war_ui_sec_endurance_tt"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 40 40 } texture = "gfx/interface/icons/military_icons/morale.dds" }
		flowcontainer = {
			direction = vertical spacing = 2
			textbox = { multiline = yes autoresize = yes minimumsize = { 472 -1 } maximumsize = { 472 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_endurance_cerrito" }
			green_progressbar_horizontal = {
				size = { 472 22 }
				blockoverride "values" {
					value = "[JournalEntry.MakeScope.ScriptValue('gg_ui_exhaustion_cerrito_pct')]"
					min = 0 max = 100
				}
			}
		}
	}
	# EN/ES: the peace table, only when there is something on it / la mesa de paz, solo si hay algo encima
	textbox = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_table_shown'), '(CFixedPoint)1')]"
		size = { 520 34 }
		parentanchor = hcenter
		using = fontsize_large align = center|nobaseline
		background = { using = entry_bg_fancy_dark alpha = 0.6 }
		text = "gg_war_ui_sec_table"
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)2')]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 32 32 } texture = "gfx/interface/icons/generic_icons/diplomatic_treaties.dds" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_diplomacy_2" }
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)3')]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 32 32 } texture = "gfx/interface/icons/generic_icons/diplomatic_treaties.dds" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_diplomacy_3" }
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)4')]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 32 32 } texture = "gfx/interface/icons/generic_icons/diplomatic_treaties.dds" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_diplomacy_4" }
	}
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_war_diplomacy'), '(CFixedPoint)5')]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 32 32 } texture = "gfx/interface/icons/generic_icons/diplomatic_treaties.dds" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } using = fontsize_medium align = left|nobaseline text = "gg_war_ui_diplomacy_5" }
	}
	flowcontainer = {
		visible = "[GetGlobalVariable('gg_imperial_pledged').IsSet]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		flag = { datacontext = "[GetGlobalVariable('gg_flag_brz').GetCountry]" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 440 -1 } maximumsize = { 440 -1 } using = fontsize_medium align = left|nobaseline text = "gg_ui_brazil_commitment" }
	}
	flowcontainer = {
		visible = "[GetGlobalVariable('gg_customs_mortgaged').IsSet]"
		direction = horizontal spacing = 8 parentanchor = hcenter
		icon = { size = { 32 32 } texture = "gfx/interface/icons/generic_icons/money.dds" }
		textbox = { autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } using = fontsize_medium align = left|nobaseline text = "gg_ui_customs_commitment" }
	}
	widget = { size = { 520 4 } }
	# EN/ES: the longer account, behind the arrow / lo largo, detras de la flechita
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_war_ui_rules_toggle" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_war_rules_open')]" }
		blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_war_rules_open'))]" }
		blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_war_rules_open')]" }
	}
	textbox = {
		visible = "[GetVariableSystem.Exists('gg_war_rules_open')]"
		autoresize = yes multiline = yes
		minimumsize = { 500 -1 } maximumsize = { 500 -1 }
		parentanchor = hcenter
		align = left|nobaseline
		using = fontsize_medium
		text = "je_guerra_grande_reason"
	}
}
