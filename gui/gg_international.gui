flowcontainer = {
	name = "gg_international_details"
	visible = "[Not(Or(GetVariableSystem.HasValue('gg_plata_tab', 'proposals'), GetVariableSystem.HasValue('gg_plata_tab', 'agreements')))]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 4
	# EN/ES: Native Meiji collapse control; UI-only state / plegado nativo, no cambia la partida.
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_ui_details_title" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_international_details_open')]" }
		blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_international_details_open'))]" }
		blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_international_details_open')]" }
	}
	textbox = {
		visible = "[GetVariableSystem.Exists('gg_international_details_open')]"
		autoresize = yes
		multiline = yes
		minimumsize = { 500 -1 }
		maximumsize = { 500 -1 }
		parentanchor = hcenter
		align = left|nobaseline
		using = fontsize_medium
		text = "gg_int_reason"
	}
}
