# EN: Original bilateral layout inspired by shared-situation and diplomatic dossier references.
# ES: Disposicion bilateral propia inspirada en situaciones compartidas y expedientes diplomaticos.
types gg_international_widget_types {
 type gg_int_mission = widget {
  size = { 252 82 }
  background = { using = dark_area alpha = 0.3 }
  block "mission_tooltip" { tooltip = "gg_ui_backing_tt" }
  textbox = {
   position = { 10 6 } size = { 232 32 }
   align = left|vcenter using = fontsize_large
   block "actor" { text = "gg_ui_rosas" }
  }
  textbox = {
   position = { 10 44 } size = { 140 26 }
   align = left|vcenter using = fontsize_medium text = "gg_ui_backing_header"
  }
  textbox = {
   position = { 150 40 } size = { 92 32 }
   align = right|vcenter using = fontsize_large
   block "backing" { text = "gg_ui_rosas_value" }
  }
 }
}

flowcontainer = {
 name = "gg_international_ledger"
 visible = "[Not(Or(GetVariableSystem.HasValue('gg_plata_tab', 'proposals'), GetVariableSystem.HasValue('gg_plata_tab', 'agreements')))]"
 direction = vertical parentanchor = hcenter spacing = 8 ignoreinvisible = yes
 textbox = {
  size = { 520 32 } align = hcenter|vcenter using = fontsize_medium
  text = "gg_ui_phase_alignments"
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_int_ui_phase'), '(CFixedPoint)0')]"
 }
 textbox = {
  size = { 520 32 } align = hcenter|vcenter using = fontsize_medium
  text = "gg_ui_phase_intervention"
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_int_ui_phase'), '(CFixedPoint)1')]"
 }
 textbox = {
  size = { 520 32 } align = hcenter|vcenter using = fontsize_medium
  text = "gg_ui_phase_mediation"
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_int_ui_phase'), '(CFixedPoint)2')]"
 }
 flowcontainer = {
  direction = horizontal spacing = 16
  flowcontainer = {
   direction = vertical spacing = 8 ignoreinvisible = yes
   textbox = { size = { 252 36 } align = hcenter|vcenter using = fontsize_large text = "gg_ui_side_defensa" }
			gg_int_mission = {

				blockoverride "actor" { text = "gg_ui_france" }
				blockoverride "backing" { text = "gg_ui_france_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_france_tt" }
			}
			gg_int_mission = {

				blockoverride "actor" { text = "gg_ui_britain" }
				blockoverride "backing" { text = "gg_ui_britain_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_britain_tt" }
			}
			gg_int_mission = {

				blockoverride "actor" { text = "gg_ui_brazil" }
				blockoverride "backing" { text = "gg_ui_brazil_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_brazil_tt" }
			}
			gg_int_mission = {
				visible = "[GetGlobalVariable('gg_urquiza_flipped').IsSet]"
				blockoverride "actor" { text = "gg_ui_urquiza" }
				blockoverride "backing" { text = "gg_ui_urquiza_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_urquiza_tt" }
			}
  }
  flowcontainer = {
   direction = vertical spacing = 8 ignoreinvisible = yes
   textbox = { size = { 252 36 } align = hcenter|vcenter using = fontsize_large text = "gg_ui_side_oribe" }
			gg_int_mission = {

				blockoverride "actor" { text = "gg_ui_rosas" }
				blockoverride "backing" { text = "gg_ui_rosas_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_rosas_tt" }
			}
			gg_int_mission = {
				visible = "[Not(GetGlobalVariable('gg_urquiza_flipped').IsSet)]"
				blockoverride "actor" { text = "gg_ui_urquiza" }
				blockoverride "backing" { text = "gg_ui_urquiza_value" }
				blockoverride "mission_tooltip" { tooltip = "gg_ui_urquiza_tt" }
			}
  }
 }
 # EN: C10 (22/9/2026) -- the Overview is the key of the river: both banks, the passage, the powers'
 #     patience against its threshold, the river's weight in the war, and port blockades on their own
 #     line. Every value is computed in script (gg_rio_plata.txt); nothing is calculated when drawing.
 # ES: C10 -- el Panorama es la llave del rio: las dos orillas, el paso, la paciencia de las potencias
 #     contra su umbral, el peso del rio en la guerra, y los bloqueos de puertos en su propia linea.
 #     Todo valor se calcula en script; nada se calcula al dibujar.
 flowcontainer = {
  direction = vertical spacing = 8 ignoreinvisible = yes
  textbox = {
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_large align = left|nobaseline
   text = "gg_ui_plata_key_header"
  }
  flowcontainer = {
   direction = horizontal spacing = 16
   flowcontainer = {
    direction = vertical spacing = 4 ignoreinvisible = yes
    background = { using = dark_area alpha = 0.3 }
    textbox = {
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_large align = left|nobaseline
     text = "gg_ui_plata_ba_title"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_holder'), '(CFixedPoint)1')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_ba_rosas"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_holder'), '(CFixedPoint)0')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_ba_other"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort'), '(CFixedPoint)1')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_ba_fort_yes"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort'), '(CFixedPoint)0')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_ba_fort_no"
    }
   }
   flowcontainer = {
    direction = vertical spacing = 4 ignoreinvisible = yes
    background = { using = dark_area alpha = 0.3 }
    textbox = {
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_large align = left|nobaseline
     text = "gg_ui_plata_mvd_title"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_holder'), '(CFixedPoint)1')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_mvd_defensa"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_holder'), '(CFixedPoint)2')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_mvd_cerrito"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_holder'), '(CFixedPoint)0')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_mvd_other"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_fort'), '(CFixedPoint)1')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_mvd_fort_yes"
    }
    textbox = {
     visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_fort'), '(CFixedPoint)0')]"
     autoresize = yes multiline = yes
     minimumsize = { 252 -1 } maximumsize = { 252 -1 }
     using = fontsize_medium align = left|nobaseline
     text = "gg_ui_plata_mvd_fort_no"
    }
   }
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_closed'), '(CFixedPoint)1')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_large align = left|nobaseline
   text = "gg_ui_plata_passage_closed"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_closed'), '(CFixedPoint)0')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_large align = left|nobaseline
   text = "gg_ui_plata_passage_open"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_powers_stage'), '(CFixedPoint)0')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_powers_0"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_powers_stage'), '(CFixedPoint)1')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_powers_1"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_powers_stage'), '(CFixedPoint)2')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_powers_2"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_powers_stage'), '(CFixedPoint)3')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_powers_3"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_powers_stage'), '(CFixedPoint)4')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_powers_4"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)1')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_weight_blancos"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)-1')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_weight_colorados"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)0')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_weight_even"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_blockaded'), '(CFixedPoint)1')]"
   autoresize = yes multiline = yes
   minimumsize = { 520 -1 } maximumsize = { 520 -1 }
   using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_port_blockade"
  }

 button_standard = {
  size = { 520 48 } text = "guerra_grande_foreign_intervention_button" tooltip = "gg_ui_squadrons_action_tt"
  visible = "[GetScriptedGui('gg_ui_call_squadrons').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  enabled = "[GetScriptedGui('gg_ui_call_squadrons').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('gg_ui_call_squadrons').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
 }

}

# EN: Original presentation; tab selection is local UI state, never a diplomatic action.
# ES: Presentacion propia; elegir pestaña no ejecuta ninguna accion diplomatica.
flowcontainer = {
	name = "gg_plata_navigation"
	direction = vertical
	parentanchor = hcenter
	spacing = 8
	# EN/ES: Breathing room below the journal header / Aire bajo el encabezado.
	widget = { size = { 520 16 } }
	flowcontainer = {
		direction = horizontal
		spacing = 8
		button_standard = {
			size = { 168 40 }
			text = "gg_ui_tab_overview"
			onclick = "[GetVariableSystem.Set('gg_plata_tab', 'overview')]"
			enabled = "[Or(GetVariableSystem.HasValue('gg_plata_tab', 'proposals'), GetVariableSystem.HasValue('gg_plata_tab', 'agreements'))]"
		}
		button_standard = {
			size = { 168 40 }
			text = "gg_ui_tab_proposals"
			onclick = "[GetVariableSystem.Set('gg_plata_tab', 'proposals')]"
			enabled = "[Not(GetVariableSystem.HasValue('gg_plata_tab', 'proposals'))]"
		}
		button_standard = {
			size = { 168 40 }
			text = "gg_ui_tab_agreements"
			onclick = "[GetVariableSystem.Set('gg_plata_tab', 'agreements')]"
			enabled = "[Not(GetVariableSystem.HasValue('gg_plata_tab', 'agreements'))]"
		}
	}
	widget = { size = { 520 8 } }
}

