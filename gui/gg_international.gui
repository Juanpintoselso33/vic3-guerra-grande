# EN: THE RIVER PLATE QUESTION as an international situation (22/9/2026). Original layout, modelled
#     on the situation journals of Gates of the Bosphorus / Community Mod Framework (no code taken):
#     your role, two leaders face to face, what each side wins, the current phase and its effects,
#     the factions, the river's weight in the war, and the actions your role allows. The two native
#     bars (towards the ultimatum, towards the city's surrender) are the journal's own.
#     Everything the old journal showed and the river no longer needs is gone: tabs, patron cards,
#     banks in prose, details. The Argentine remittance moved to the Federal Pact.
# ES: LA CUESTION DEL PLATA como situacion internacional. Disposicion propia, inspirada en las
#     situaciones de Gates of the Bosphorus / Community Mod Framework (sin tomar codigo): tu papel,
#     dos lideres cara a cara, que gana cada lado, la fase y sus efectos, las facciones, el peso del
#     rio en la guerra y lo que tu papel te deja hacer. Las dos barras nativas son del journal.
# EN/ES: the header IS the chart: it takes the icon's place, nothing on it
#     / el encabezado ES la carta: ocupa el lugar del icono
widget = {
 name = "gg_plata_header"
 size = { 520 196 }
 parentanchor = hcenter
 icon = {
  size = { 520 190 }
  position = { 0 6 }
  texture = "gfx/interface/gg_situations/plata_header.dds"
 }
}
flowcontainer = {
 name = "gg_plata_situation"
 direction = vertical parentanchor = hcenter spacing = 10 ignoreinvisible = yes
 # EN/ES: face to face only once they face each other (from the split) / cara a cara solo desde la particion
 flowcontainer = {
  visible = "[GetGlobalVariable('guerra_grande_split_done').IsSet]"
  direction = horizontal spacing = 8 parentanchor = hcenter
  flowcontainer = {
   direction = vertical ignoreinvisible = yes
   dynamicgridbox = {
    datamodel = "[JournalEntry.GetInvolvedCountries]"
    datamodel_wrap = 1
    ignoreinvisible = yes
    item = {
     widget = {
      visible = "[GetScriptedGui('gg_ui_plata_left_leader').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
      tooltip = "gg_ui_plata_card_ba_tt"
      size = { 236 112 }
      background = { using = dark_area alpha = 0.3 }
      character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
      textbox = {
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_rosas"
      }
     }
    }
   }
  }
  textbox = { size = { 32 112 } align = center|vcenter using = fontsize_large text = "gg_ui_plata_versus" }
  flowcontainer = {
   direction = vertical ignoreinvisible = yes
   dynamicgridbox = {
    datamodel = "[JournalEntry.GetInvolvedCountries]"
    datamodel_wrap = 1
    ignoreinvisible = yes
    item = {
     widget = {
      visible = "[GetScriptedGui('gg_ui_plata_right_defensa').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
      tooltip = "gg_ui_plata_card_mvd_tt"
      size = { 236 112 }
      background = { using = dark_area alpha = 0.3 }
      character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
      textbox = {
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_defensa"
      }
     }
    }
   }
   dynamicgridbox = {
    datamodel = "[JournalEntry.GetInvolvedCountries]"
    datamodel_wrap = 1
    ignoreinvisible = yes
    item = {
     widget = {
      visible = "[GetScriptedGui('gg_ui_plata_right_powers').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
      tooltip = "gg_ui_plata_card_mvd_tt"
      size = { 236 112 }
      background = { using = dark_area alpha = 0.3 }
      character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
      textbox = {
       visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_envoy'), '(CFixedPoint)0')]"
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_envoy_0"
      }
      textbox = {
       visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_envoy'), '(CFixedPoint)1')]"
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_envoy_1"
      }
      textbox = {
       visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_envoy'), '(CFixedPoint)2')]"
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_envoy_2"
      }
      textbox = {
       visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_envoy'), '(CFixedPoint)3')]"
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_envoy_3"
      }
      textbox = {
       visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_envoy'), '(CFixedPoint)4')]"
       position = { 96 8 } size = { 134 96 }
       datacontext = "[Country.GetRuler]"
       multiline = yes using = fontsize_medium
       text = "gg_ui_plata_leader_envoy_4"
      }
     }
    }
   }
  }
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)0')]"
  tooltip = "gg_ui_plata_phase_0_tt"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_large align = left|nobaseline
  text = "gg_ui_plata_phase_0"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)1')]"
  tooltip = "gg_ui_plata_phase_1_tt"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_large align = left|nobaseline
  text = "gg_ui_plata_phase_1"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)2')]"
  tooltip = "gg_ui_plata_phase_2_tt"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_large align = left|nobaseline
  text = "gg_ui_plata_phase_2"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)3')]"
  tooltip = "gg_ui_plata_phase_3_tt"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_large align = left|nobaseline
  text = "gg_ui_plata_phase_3"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)4')]"
  tooltip = "gg_ui_plata_phase_4_tt"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_large align = left|nobaseline
  text = "gg_ui_plata_phase_4"
 }
 # EN/ES: the key to the river, one card per shore / la llave del rio, una tarjeta por orilla
 flowcontainer = {
  direction = horizontal spacing = 8 parentanchor = hcenter
 widget = {
  size = { 256 76 }
  background = { using = dark_area alpha = 0.3 }
  tooltip = "gg_ui_plata_key_tt"
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort_sv'), '(CFixedPoint)1')]"
   position = { 10 6 } size = { 236 64 }
   multiline = yes using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_shore_ba_fort"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort_sv'), '(CFixedPoint)0')]"
   position = { 10 6 } size = { 236 64 }
   multiline = yes using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_shore_ba_nofort"
  }
 }
 widget = {
  size = { 256 76 }
  background = { using = dark_area alpha = 0.3 }
  tooltip = "gg_ui_plata_key_tt"
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_fort_sv'), '(CFixedPoint)1')]"
   position = { 10 6 } size = { 236 64 }
   multiline = yes using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_shore_mvd_fort"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_mvd_fort_sv'), '(CFixedPoint)0')]"
   position = { 10 6 } size = { 236 64 }
   multiline = yes using = fontsize_medium align = left|nobaseline
   text = "gg_ui_plata_shore_mvd_nofort"
  }
 }
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)1')]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_ui_plata_weight_blancos"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)-1')]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_ui_plata_weight_colorados"
 }
 textbox = {
  visible = "[And(GetGlobalVariable('guerra_grande_split_done').IsSet, EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_weight_side'), '(CFixedPoint)0'))]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_ui_plata_weight_even"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_blockaded'), '(CFixedPoint)1')]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_ui_plata_port_blockade"
 }
 # EN/ES: the two clocks, our own bars: not in the pinned preview, and only once they measure something
 #     / los dos relojes, barras propias: fuera de la vista previa, y solo cuando miden algo
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_patience_shown'), '(CFixedPoint)1')]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_plata_patience_bar_desc"
 }
 green_progressbar_horizontal = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_patience_shown'), '(CFixedPoint)1')]"
  size = { 520 30 }
  blockoverride "values" {
   value = "[JournalEntry.MakeScope.ScriptValue('gg_plata_patience_pct')]"
   min = 0 max = 100
  }
  tooltip = "gg_plata_patience_bar"
 }
 textbox = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_hunger_shown'), '(CFixedPoint)1')]"
  autoresize = yes multiline = yes
  minimumsize = { 520 -1 } maximumsize = { 520 -1 }
  using = fontsize_medium align = left|nobaseline
  text = "gg_plata_hunger_bar_desc"
 }
 green_progressbar_horizontal = {
  visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_hunger_shown'), '(CFixedPoint)1')]"
  size = { 520 30 }
  blockoverride "values" {
   value = "[JournalEntry.MakeScope.ScriptValue('gg_plata_hunger_pct')]"
   min = 0 max = 100
  }
  tooltip = "gg_plata_hunger_bar"
 }
 button_standard = {
  size = { 520 48 } text = "guerra_grande_foreign_intervention_button" tooltip = "gg_ui_squadrons_action_tt"
  visible = "[GetScriptedGui('gg_ui_call_squadrons').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  enabled = "[GetScriptedGui('gg_ui_call_squadrons').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('gg_ui_call_squadrons').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}
