# EN: THE RIVER PLATE QUESTION, third pass (22/9/2026, Juan: «try not to use only text»): the chart as
#     the header with the phase on it; one short line; the river drawn as two shores (flag; Buenos Aires's battery, Montevideo's supply)
#     and the passage between them (open/closed); from the split, the two leaders; the two clocks and
#     the port blockade only while they run; the longer explanation behind the arrow; the action.
# ES: LA CUESTION DEL PLATA, tercera pasada: la carta de encabezado con la fase encima; una linea
#     corta; el rio dibujado como dos orillas (bandera, bateria) y el paso entre ellas (abierto o
#     cerrado); desde la particion, los dos lideres; los dos relojes y el bloqueo de puerto solo
#     mientras corren; lo largo detras de la flechita; la accion.
#     Chart: "New Chart of the River Plate", E. & G. W. Blunt, New York 1840 (public domain, Gallica).
widget = {
 name = "gg_plata_header"
 size = { 520 252 }
 parentanchor = hcenter
 icon = {
  size = { 520 240 }
  position = { 0 6 }
  texture = "gfx/interface/gg_situations/plata_header.dds"
 }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)0')]"
   tooltip = "gg_ui_plata_phase_0_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_0"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)1')]"
   tooltip = "gg_ui_plata_phase_1_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_1"
  }
  textbox = {
   visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)2'), EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_london_mode'), '(CFixedPoint)0'))]"
   tooltip = "gg_ui_plata_phase_2_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_2"
  }
  textbox = {
   visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)2'), Not(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_london_mode'), '(CFixedPoint)0')))]"
   tooltip = "gg_ui_plata_phase_2_france_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_2"
  }
  textbox = {
   visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)3'), Not(GetGlobalVariable('gg_plata_france_alone').IsSet))]"
   tooltip = "gg_ui_plata_phase_3_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_3"
  }
  textbox = {
   visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)3'), GetGlobalVariable('gg_plata_france_alone').IsSet)]"
   tooltip = "gg_ui_plata_phase_3_france_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_3_france"
  }
  textbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_plata_phase'), '(CFixedPoint)4')]"
   tooltip = "gg_ui_plata_phase_4_tt"
   position = { 0 206 } size = { 520 40 }
   background = { using = dark_area alpha = 0.8 }
   using = fontsize_large align = center|nobaseline
   text = "gg_ui_plata_phase_4"
  }
}
