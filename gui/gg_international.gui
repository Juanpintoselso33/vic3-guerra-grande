   icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_closed_sv'), '(CFixedPoint)1')]" position = { 12 44 } size = { 96 96 } texture = "gfx/interface/icons/straits_icons/straits_no_access.dds" }
   textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_closed_sv'), '(CFixedPoint)0')]" position = { 0 150 } size = { 120 32 } using = fontsize_large align = center|nobaseline text = "gg_ui_plata_passage_open" }
