   textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort_sv'), '(CFixedPoint)1')]" position = { 70 158 } size = { 120 26 } using = fontsize_medium align = left|nobaseline text = "gg_ui_plata_battery_yes" }
   textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_ba_fort_sv'), '(CFixedPoint)0')]" position = { 70 158 } size = { 120 26 } using = fontsize_medium align = left|nobaseline text = "gg_ui_plata_battery_no" }
