   large_flag = { position = { 50 16 } datacontext = "[GetGlobalVariable('gg_plata_mvd_owner').GetCountry]" }
   textbox = { position = { 0 92 } size = { 196 50 } multiline = yes using = fontsize_medium align = center|nobaseline text = "gg_ui_plata_shore_mvd" }
   # EN/ES: Montevideo's shore never closes the river; what matters is whether ships reach it / la orilla de Montevideo nunca cierra el rio; importa si le llegan barcos
   icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_plata_closed_sv'), '(CFixedPoint)0')]" position = { 16 150 } size = { 40 40 } texture = "gfx/interface/icons/building_icons/building_port.dds" }
