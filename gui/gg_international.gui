 # EN/ES: the longer explanation, behind the arrow / lo largo, detras de la flechita
 section_header_button = {
  blockoverride "layout" { size = { 520 38 } }
  blockoverride "left_text" { text = "gg_ui_plata_more" }
  blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_plata_more_open')]" }
  blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_plata_more_open'))]" }
  blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_plata_more_open')]" }
 }
 textbox = {
  visible = "[GetVariableSystem.Exists('gg_plata_more_open')]"
  autoresize = yes multiline = yes
  minimumsize = { 500 -1 } maximumsize = { 500 -1 }
  parentanchor = hcenter
  align = left|nobaseline
  using = fontsize_medium
  text = "gg_ui_plata_more_body"
 }
 button_standard = {
  size = { 520 48 } text = "guerra_grande_foreign_intervention_button" tooltip = "gg_ui_squadrons_action_tt"
  visible = "[GetScriptedGui('gg_ui_call_squadrons').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  enabled = "[GetScriptedGui('gg_ui_call_squadrons').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('gg_ui_call_squadrons').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}
