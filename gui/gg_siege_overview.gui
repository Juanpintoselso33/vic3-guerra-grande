				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_italian'), '(CFixedPoint)0')]" autoresize = yes multiline = yes minimumsize = { 204 -1 } maximumsize = { 204 -1 } tooltip = "gg_siege_ui_italian_tt" using = fontsize_medium align = left|nobaseline text = "gg_siege_ui_italian_0" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_italian'), '(CFixedPoint)1')]" autoresize = yes multiline = yes minimumsize = { 204 -1 } maximumsize = { 204 -1 } tooltip = "gg_siege_ui_italian_tt" using = fontsize_medium align = left|nobaseline text = "gg_siege_ui_italian_1" }
