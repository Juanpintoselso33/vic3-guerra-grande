				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_french'), '(CFixedPoint)2')]" autoresize = yes multiline = yes minimumsize = { 204 -1 } maximumsize = { 204 -1 } tooltip = "gg_siege_ui_french_tt" using = fontsize_medium align = left|nobaseline text = "gg_siege_ui_french_2" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_french'), '(CFixedPoint)3')]" autoresize = yes multiline = yes minimumsize = { 204 -1 } maximumsize = { 204 -1 } tooltip = "gg_siege_ui_french_tt" using = fontsize_medium align = left|nobaseline text = "gg_siege_ui_french_3" }
				}
			}
			flowcontainer = {
