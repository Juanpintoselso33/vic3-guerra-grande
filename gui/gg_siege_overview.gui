# EN: EL SITIO GRANDE as a local situation (22/9/2026 redesign, same frame as the war journal):
#     the besieger and the defender face to face, and the conditions each side carries right now.
#     The river, the hunger and the blockade are the River Plate situation's; they left this journal.
# ES: EL SITIO GRANDE como situacion local: el que sitia y el que defiende cara a cara, y las
#     condiciones que carga hoy cada lado. El rio, el hambre y el bloqueo son de la situacion del
#     Plata; salieron de este journal.
flowcontainer = {
 name = "gg_siege_overview"
 direction = vertical parentanchor = hcenter spacing = 10 ignoreinvisible = yes
 widget = { size = { 520 8 } }
 flowcontainer = {
  direction = horizontal spacing = 8 parentanchor = hcenter
  dynamicgridbox = {
   datamodel = "[JournalEntry.GetInvolvedCountries]"
   datamodel_wrap = 1
   ignoreinvisible = yes
   item = {
    widget = {
     visible = "[GetScriptedGui('gg_ui_cerrito_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
     size = { 236 112 }
     background = { using = dark_area alpha = 0.3 }
     character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
     textbox = { position = { 96 8 } size = { 134 96 } datacontext = "[Country.GetRuler]" multiline = yes using = fontsize_medium text = "gg_ui_siege_leader_besieger" }
    }
   }
  }
  textbox = { size = { 32 112 } align = center|vcenter using = fontsize_large text = "gg_ui_plata_versus" }
  dynamicgridbox = {
   visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_pacheco'), '(CFixedPoint)1')]"
   datamodel = "[JournalEntry.GetInvolvedCountries]"
   datamodel_wrap = 1
   ignoreinvisible = yes
   item = {
    flowcontainer = {
     dynamicgridbox = {
      datamodel = "[Country.MakeScope.GetList('gg_ui_siege_defender')]"
      datamodel_wrap = 1
      item = {
       widget = {
        size = { 236 112 }
        background = { using = dark_area alpha = 0.3 }
        character_portrait_medium = { position = { 6 10 } datacontext = "[Scope.AccessCharacter]" }
        textbox = { position = { 96 8 } size = { 134 96 } datacontext = "[Scope.AccessCharacter]" multiline = yes using = fontsize_medium text = "gg_ui_siege_leader_defender" }
       }
      }
     }
    }
   }
  }
  dynamicgridbox = {
    visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_siege_pacheco'), '(CFixedPoint)0')]"
   datamodel = "[JournalEntry.GetInvolvedCountries]"
   datamodel_wrap = 1
   ignoreinvisible = yes
   item = {
    widget = {
     visible = "[GetScriptedGui('gg_ui_defensa_government').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
     size = { 236 112 }
     background = { using = dark_area alpha = 0.3 }
     character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
     textbox = { position = { 96 8 } size = { 134 96 } datacontext = "[Country.GetRuler]" multiline = yes using = fontsize_medium text = "gg_ui_siege_leader_government" }
    }
   }
  }
 }
