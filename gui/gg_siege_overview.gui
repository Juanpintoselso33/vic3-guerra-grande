# EN/ES: below the buttons (custom_widget_container_4): the longer account, behind the arrow
#     / debajo de los botones: lo largo, detras de la flechita
flowcontainer = {
	name = "gg_siege_more"
	direction = vertical
	parentanchor = hcenter
	spacing = 10
	ignoreinvisible = yes
	widget = { size = { 520 4 } }
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_siege_ui_more" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_siege_about_open')]" }
		blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_siege_about_open'))]" }
		blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_siege_about_open')]" }
	}
	textbox = {
		visible = "[GetVariableSystem.Exists('gg_siege_about_open')]"
		autoresize = yes multiline = yes
		minimumsize = { 500 -1 } maximumsize = { 500 -1 }
		parentanchor = hcenter
		align = left|nobaseline
		using = fontsize_medium
		text = "gg_siege_ui_more_body"
	}
}
