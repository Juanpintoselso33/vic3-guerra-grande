		icon = { position = { 115 12 } size = { 290 416 } texture = "gfx/interface/gg_situations/pact_jujuy.dds" color = { 0.56 0.70 0.66 1 } visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_jujuy'), '(CFixedPoint)0')]" }
