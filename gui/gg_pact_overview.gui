			autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } parentanchor = hcenter
			using = fontsize_small align = center|nobaseline text = "gg_pact_j_grv_none"
		}
		textbox = {
			visible = "[GetGlobalVariable('gg_pact_gov_coalicion').IsSet]"
			datacontext = "[GetGlobalVariable('gg_pact_gov_coalicion').GetCharacter]"
			autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } parentanchor = hcenter
			using = fontsize_small align = center|nobaseline text = "gg_pact_j_league"
		}
		flowcontainer = {
			direction = horizontal spacing = 4 parentanchor = hcenter
			# EN/ES: tucuman
			widget = {
				size = { 248 120 }
				background = { using = dark_area alpha = 0.35 }
				textbox = { position = { 0 4 } size = { 248 26 } using = fontsize_medium align = center|nobaseline text = "gg_pact_j_name_tucuman" }
				character_portrait_medium = {
