					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_catamarca'), '(CFixedPoint)2')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_catamarca_2" }
				}
				widget = {
					size = { 78 34 }
					background = { using = entry_bg_fancy_dark alpha = 0.6 }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_la_rioja'), '(CFixedPoint)0')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_la_rioja_0" }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_la_rioja'), '(CFixedPoint)1')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_la_rioja_1" }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_la_rioja'), '(CFixedPoint)2')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_la_rioja_2" }
				}
				widget = {
					size = { 78 34 }
					background = { using = entry_bg_fancy_dark alpha = 0.6 }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_cordoba'), '(CFixedPoint)0')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_cordoba_0" }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_cordoba'), '(CFixedPoint)1')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_cordoba_1" }
					textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_cordoba'), '(CFixedPoint)2')]" size = { 78 34 } multiline = yes using = fontsize_small align = center|vcenter text = "gg_pact_j_chip_cordoba_2" }
				}
			}
		}
		# EN/ES: entre_rios
		widget = {
			size = { 500 104 }
			parentanchor = hcenter
			background = { using = dark_area alpha = 0.35 }
			tooltip = "gg_pact_j_row_entre_rios_tt"
			character_portrait_medium = {
				visible = "[GetGlobalVariable('gg_pact_gov_entre_rios').IsSet]"
				position = { 8 8 }
				datacontext = "[GetGlobalVariable('gg_pact_gov_entre_rios').GetCharacter]"
			}
			textbox = { position = { 100 8 } size = { 236 32 } using = fontsize_large align = left|nobaseline text = "gg_pact_j_row_entre_rios" }
			textbox = {
				visible = "[GetGlobalVariable('gg_pact_gov_entre_rios').IsSet]"
				datacontext = "[GetGlobalVariable('gg_pact_gov_entre_rios').GetCharacter]"
				position = { 100 44 } size = { 236 52 } multiline = yes
				using = fontsize_medium align = left|nobaseline text = "gg_pact_j_gov_entre_rios"
			}
			icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)0')]" position = { 344 10 } size = { 36 36 } texture = "gfx/interface/icons/generic_icons/approval_icon.dds" }
			icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)1')]" position = { 344 10 } size = { 36 36 } texture = "gfx/interface/icons/generic_icons/maybe_icon.dds" }
			icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)2')]" position = { 344 10 } size = { 36 36 } texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds" }
			textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)0')]" position = { 386 8 } size = { 108 40 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_st_0" }
			textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)1')]" position = { 386 8 } size = { 108 40 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_st_1" }
			textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)2')]" position = { 386 8 } size = { 108 40 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_st_2" }
			icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_grv_entre_rios'), '(CFixedPoint)1')]" position = { 346 56 } size = { 32 32 } texture = "gfx/interface/icons/generic_icons/population_radical.dds" }
			textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_grv_entre_rios'), '(CFixedPoint)1')]" position = { 386 52 } size = { 108 40 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_grv_entre_rios" }
			textbox = { visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_grv_entre_rios'), '(CFixedPoint)0'), Not(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_entre_rios'), '(CFixedPoint)2')))]" position = { 386 52 } size = { 108 40 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_grv_none" }
		}
	}
	# EN/ES: the longer account behind the arrow / lo largo detras de la flechita
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_pact_j_more" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_pact_about_open')]" }
		blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_pact_about_open'))]" }
		blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_pact_about_open')]" }
	}
	textbox = {
		visible = "[GetVariableSystem.Exists('gg_pact_about_open')]"
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = left|nobaseline
		text = "gg_pact_j_more_body"
	}
}
