	textbox = {
		size = { 520 40 }
		parentanchor = hcenter
		background = { using = dark_area alpha = 0.85 }
		using = fontsize_large align = center|nobaseline
		text = "gg_pact_j_band"
		tooltip = "gg_pact_j_band_tt"
	}
	textbox = {
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_pact_j_legend"
	}
	# EN/ES: the list, open unless closed / la lista, abierta salvo que se la cierre
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_pact_j_list_header" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_pact_list_closed')]" }
		blockoverride "onclick_showmore" { visible = "[GetVariableSystem.Exists('gg_pact_list_closed')]" }
		blockoverride "onclick_showless" { visible = "[Not(GetVariableSystem.Exists('gg_pact_list_closed'))]" }
	}
	# EN: 23/9/2026 (Juan: "no me gusta NADA como las agrupaste... en bloques") -- ONE TABLE of thirteen rows,
	#     no sections: the province, the face and name of who governs it (gg_pact_gov_<key>,
	#     common/scripted_effects/gg_pact_governors.txt), its state. Sorted by state: every row exists three
	#     times and shows only under its state, so the withdrawn come first, then the pending, then the rest.
	#     The grievances, kept per section by the code, go under the table, only while active.
	# ES: UNA TABLA de trece filas, sin secciones: provincia, cara y nombre de quien gobierna, estado. Ordenada
	#     por estado (cada fila existe tres veces y se ve solo con el suyo). Los agravios, debajo, solo activos.
	flowcontainer = {
		visible = "[Not(GetVariableSystem.Exists('gg_pact_list_closed'))]"
		direction = vertical spacing = 6 parentanchor = hcenter ignoreinvisible = yes
		flowcontainer = {
			direction = vertical spacing = 3 parentanchor = hcenter ignoreinvisible = yes
			# EN/ES: corrientes
