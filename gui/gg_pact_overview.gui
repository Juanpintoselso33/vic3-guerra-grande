	textbox = {
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_pact_j_legend"
	}
	# EN/ES: Buenos Aires facing the provinces that took the mandate back / Buenos Aires frente a las que lo retiraron
	flowcontainer = {
		visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_front_shown'), '(CFixedPoint)1')]"
		direction = vertical spacing = 12 parentanchor = hcenter ignoreinvisible = yes
		textbox = {
			size = { 520 34 }
			parentanchor = hcenter
			using = fontsize_large align = center|nobaseline
			background = { using = entry_bg_fancy_dark alpha = 0.6 }
			text = "gg_pact_j_sec_front"
		}
		flowcontainer = {
			direction = horizontal spacing = 8 parentanchor = hcenter
			flowcontainer = {
				direction = vertical ignoreinvisible = yes
			dynamicgridbox = {
				datamodel = "[JournalEntry.GetInvolvedCountries]"
				datamodel_wrap = 1
				ignoreinvisible = yes
				item = {
					widget = {
						visible = "[GetScriptedGui('gg_ui_pact_holder').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
						size = { 236 112 }
						background = { using = dark_area alpha = 0.3 }
						tooltip = "gg_pact_j_holder_tt"
						character_portrait_medium = { position = { 6 10 } datacontext = "[Country.GetRuler]" }
						flag = { position = { 164 8 } datacontext = "[Country]" }
						textbox = { position = { 96 58 } size = { 134 50 } datacontext = "[Country.GetRuler]" multiline = yes using = fontsize_medium text = "gg_pact_j_holder" }
					}
				}
			}
			}
			textbox = { size = { 32 112 } align = center|vcenter using = fontsize_large text = "gg_pact_j_versus" }
			flowcontainer = {
				direction = vertical spacing = 8 ignoreinvisible = yes
			dynamicgridbox = {
				datamodel = "[JournalEntry.GetInvolvedCountries]"
				datamodel_wrap = 1
				ignoreinvisible = yes
				item = {
					widget = {
						visible = "[GetScriptedGui('gg_ui_pact_risen').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
