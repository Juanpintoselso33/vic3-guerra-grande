				character_portrait_medium = { visible = "[GetGlobalVariable('gg_pact_gov_san_luis').IsSet]" position = { 168 2 } datacontext = "[GetGlobalVariable('gg_pact_gov_san_luis').GetCharacter]" }
				textbox = { visible = "[GetGlobalVariable('gg_pact_gov_san_luis').IsSet]" datacontext = "[GetGlobalVariable('gg_pact_gov_san_luis').GetCharacter]" position = { 256 0 } size = { 136 88 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_gov" }
				textbox = { visible = "[Not(GetGlobalVariable('gg_pact_gov_san_luis').IsSet)]" position = { 168 0 } size = { 224 88 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_interim" tooltip = "gg_pact_j_interim_tt" }
				icon = { position = { 396 30 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/approval_icon.dds" }
