				visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)2')]"
				size = { 520 88 }
				background = { using = dark_area alpha = 0.35 }
				textbox = { position = { 14 0 } size = { 150 88 } multiline = yes using = fontsize_medium align = left|vcenter text = "gg_pact_j_name_corrientes" tooltip = "gg_pact_j_name_corrientes_tt" }
				character_portrait_medium = { visible = "[GetGlobalVariable('gg_pact_gov_corrientes').IsSet]" position = { 168 2 } datacontext = "[GetGlobalVariable('gg_pact_gov_corrientes').GetCharacter]" }
				textbox = { visible = "[GetGlobalVariable('gg_pact_gov_corrientes').IsSet]" datacontext = "[GetGlobalVariable('gg_pact_gov_corrientes').GetCharacter]" position = { 256 0 } size = { 136 88 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_gov" }
				textbox = { visible = "[Not(GetGlobalVariable('gg_pact_gov_corrientes').IsSet)]" position = { 168 0 } size = { 224 88 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_interim" tooltip = "gg_pact_j_interim_tt" }
