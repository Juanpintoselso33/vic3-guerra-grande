	textbox = {
		size = { 520 40 }
		parentanchor = hcenter
		background = { using = dark_area alpha = 0.85 }
		using = fontsize_large align = center|nobaseline
		text = "gg_pact_j_band"
		tooltip = "gg_pact_j_band_tt"
	}
	textbox = {
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = center|nobaseline
		text = "gg_pact_j_legend"
	}
	# EN/ES: the list, open unless closed / la lista, abierta salvo que se la cierre
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_pact_j_list_header" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_pact_list_closed')]" }
		blockoverride "onclick_showmore" { visible = "[GetVariableSystem.Exists('gg_pact_list_closed')]" }
		blockoverride "onclick_showless" { visible = "[Not(GetVariableSystem.Exists('gg_pact_list_closed'))]" }
	}
	# EN: 22/9/2026 (Juan) -- ALL THIRTEEN, in four sections: Corrientes; the North; Entre Rios; the five
	#     that never withdraw. Each card: the province, the face and name of who governs it
	#     (gg_pact_gov_<key>, common/scripted_effects/gg_pact_governors.txt), its state. The grievances
	#     belong to a section because the code keeps them per section (one for the whole North).
	# ES: LAS TRECE, en cuatro secciones. Cada tarjeta: la provincia, cara y nombre de quien la gobierna,
	#     su estado. Los agravios van por seccion porque el codigo los lleva por seccion.
	flowcontainer = {
		visible = "[Not(GetVariableSystem.Exists('gg_pact_list_closed'))]"
		direction = vertical spacing = 6 parentanchor = hcenter ignoreinvisible = yes
		flowcontainer = {
			direction = horizontal spacing = 4 parentanchor = hcenter
			# EN/ES: corrientes
			widget = {
				size = { 248 120 }
				background = { using = dark_area alpha = 0.35 }
				textbox = { position = { 0 4 } size = { 248 26 } using = fontsize_medium align = center|nobaseline text = "gg_pact_j_name_corrientes" tooltip = "gg_pact_j_name_corrientes_tt" }
				character_portrait_medium = {
					visible = "[GetGlobalVariable('gg_pact_gov_corrientes').IsSet]"
					position = { 8 34 }
					datacontext = "[GetGlobalVariable('gg_pact_gov_corrientes').GetCharacter]"
				}
				textbox = {
					visible = "[GetGlobalVariable('gg_pact_gov_corrientes').IsSet]"
					datacontext = "[GetGlobalVariable('gg_pact_gov_corrientes').GetCharacter]"
					position = { 96 34 } size = { 146 44 } multiline = yes
					using = fontsize_small align = left|nobaseline text = "gg_pact_j_gov"
				}
				textbox = {
					visible = "[Not(GetGlobalVariable('gg_pact_gov_corrientes').IsSet)]"
					position = { 8 34 } size = { 234 44 } multiline = yes
					using = fontsize_small align = center|nobaseline text = "gg_pact_j_interim" tooltip = "gg_pact_j_interim_tt"
				}
				icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)0')]" position = { 96 84 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/approval_icon.dds" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)0')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_0" tooltip = "gg_pact_j_st_0_tt" }
				icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)1')]" position = { 96 84 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/maybe_icon.dds" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)1')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_1" tooltip = "gg_pact_j_st_1_tt" }
				icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)2')]" position = { 96 84 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)2')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_2" tooltip = "gg_pact_j_st_2_tt" }
			}
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_grv_corrientes'), '(CFixedPoint)1')]"
			autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } parentanchor = hcenter
			using = fontsize_small align = center|nobaseline text = "gg_pact_j_grv_corrientes"
		}
		textbox = {
			visible = "[And(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_grv_corrientes'), '(CFixedPoint)0'), Not(EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_corrientes'), '(CFixedPoint)2')))]"
			autoresize = yes multiline = yes minimumsize = { 480 -1 } maximumsize = { 480 -1 } parentanchor = hcenter
			using = fontsize_small align = center|nobaseline text = "gg_pact_j_grv_none"
		}
		widget = { size = { 500 8 } }
