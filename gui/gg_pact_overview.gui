	# EN/ES: the longer account behind the arrow / lo largo detras de la flechita
	section_header_button = {
		blockoverride "layout" { size = { 520 38 } }
		blockoverride "left_text" { text = "gg_pact_j_more" }
		blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('gg_pact_about_open')]" }
		blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('gg_pact_about_open'))]" }
		blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('gg_pact_about_open')]" }
	}
	textbox = {
		visible = "[GetVariableSystem.Exists('gg_pact_about_open')]"
		autoresize = yes multiline = yes
		minimumsize = { 480 -1 } maximumsize = { 480 -1 }
		parentanchor = hcenter
		using = fontsize_medium align = left|nobaseline
		text = "gg_pact_j_more_body"
	}
}
