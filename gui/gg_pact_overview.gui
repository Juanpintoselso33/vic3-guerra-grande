				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_tucuman'), '(CFixedPoint)0')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_0" tooltip = "gg_pact_j_st_0_tt" }
				icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_tucuman'), '(CFixedPoint)1')]" position = { 96 84 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/maybe_icon.dds" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_tucuman'), '(CFixedPoint)1')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_1" tooltip = "gg_pact_j_st_1_tt" }
				icon = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_tucuman'), '(CFixedPoint)2')]" position = { 96 84 } size = { 28 28 } texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds" }
				textbox = { visible = "[EqualTo_CFixedPoint(JournalEntry.MakeScope.ScriptValue('gg_ui_pact_tucuman'), '(CFixedPoint)2')]" position = { 128 80 } size = { 114 36 } multiline = yes using = fontsize_small align = left|vcenter text = "gg_pact_j_st_2" tooltip = "gg_pact_j_st_2_tt" }
			}
			# EN/ES: salta
			widget = {
				size = { 248 120 }
				background = { using = dark_area alpha = 0.35 }
				textbox = { position = { 0 4 } size = { 248 26 } using = fontsize_medium align = center|nobaseline text = "gg_pact_j_name_salta" }
				character_portrait_medium = {
					visible = "[GetGlobalVariable('gg_pact_gov_salta').IsSet]"
					position = { 8 34 }
					datacontext = "[GetGlobalVariable('gg_pact_gov_salta').GetCharacter]"
				}
				textbox = {
					visible = "[GetGlobalVariable('gg_pact_gov_salta').IsSet]"
					datacontext = "[GetGlobalVariable('gg_pact_gov_salta').GetCharacter]"
					position = { 96 34 } size = { 146 44 } multiline = yes
					using = fontsize_small align = left|nobaseline text = "gg_pact_j_gov"
				}
				textbox = {
					visible = "[Not(GetGlobalVariable('gg_pact_gov_salta').IsSet)]"
					position = { 8 34 } size = { 234 44 } multiline = yes
					using = fontsize_small align = center|nobaseline text = "gg_pact_j_interim" tooltip = "gg_pact_j_interim_tt"
